[Unit]
Description=MapleStory Server Application Container
After=maplestory-db.service
BindsTo=maplestory-pod.service

[Container]
ContainerName=maplestory-server
Pod=maplestory.pod
Image=ghcr.io/yichenshen/holocron-ms:latest
AutoUpdate=registry
Environment=DB_HOST=localhost

[Service]
Restart=always
